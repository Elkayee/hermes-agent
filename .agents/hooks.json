{
  "harness-trigger": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "python scripts/kich_hoat_harness_tu_dong.py",
        "timeout": 15
      }
    ]
  },
  "context-engine-auto-activator": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "grep_search|find_by_name",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/kich_hoat_context_khi_search.py",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
